[
  {
    "id": "TV-001",
    "title": "Vulnerability scanner activity",
    "type": "threshold",
    "severity": "low",
    "tactic": "Reconnaissance",
    "technique": "T1595",
    "technique_name": "Active Scanning",
    "description": "Web requests carrying the user-agent of a well-known offensive scanner.",
    "match": {"kind": "web.request", "where": {"user_agent": "nikto|sqlmap|nmap|gobuster|dirbuster|wpscan|nuclei|masscan"}},
    "group_by": "src_ip",
    "count": 1,
    "window": 600
  },
  {
    "id": "TV-002",
    "title": "Web shell command execution",
    "type": "match",
    "severity": "critical",
    "tactic": "Persistence",
    "technique": "T1505.003",
    "technique_name": "Server Software Component: Web Shell",
    "description": "Script under a web root invoked with a command parameter - a classic web-shell pattern.",
    "match": {"kind": "web.request", "where": {"path": "\\.(php|jsp|jspx|aspx?|cgi)\\?.*\\b(cmd|exec|command|c)=", "status": {"lt": 400}}}
  },
  {
    "id": "TV-003",
    "title": "Large archive downloaded from web server",
    "type": "match",
    "severity": "high",
    "tactic": "Exfiltration",
    "technique": "T1048",
    "technique_name": "Exfiltration Over Alternative Protocol",
    "description": "An archive or database dump larger than 10 MB was served successfully.",
    "match": {"kind": "web.request", "where": {"path": "\\.(zip|7z|rar|tar|tgz|gz|sql|bak)(\\?|$)", "status": {"lt": 300}, "bytes": {"gt": 10000000}}}
  },
  {
    "id": "TV-010",
    "title": "Sudo to an interactive root shell",
    "type": "match",
    "severity": "high",
    "tactic": "Privilege Escalation",
    "technique": "T1548.003",
    "technique_name": "Abuse Elevation Control Mechanism: Sudo",
    "description": "A user spawned a root shell or changed setuid bits through sudo.",
    "match": {"kind": "priv.sudo", "where": {"target_user": "^root$", "command": "(/bin/(ba|z|da)?sh\\b|\\bsu\\b|chmod [ugo]*\\+s|python[0-9.]* -c)"}}
  },
  {
    "id": "TV-011",
    "title": "Local account created",
    "type": "match",
    "severity": "medium",
    "tactic": "Persistence",
    "technique": "T1136.001",
    "technique_name": "Create Account: Local Account",
    "description": "A new local account was created - common attacker backdoor.",
    "match": {"kind": "account.create"}
  },
  {
    "id": "TV-012",
    "title": "Crontab modified",
    "type": "match",
    "severity": "medium",
    "tactic": "Persistence",
    "technique": "T1053.003",
    "technique_name": "Scheduled Task/Job: Cron",
    "description": "A crontab was replaced or edited, which can provide scheduled re-entry.",
    "match": {"kind": "persistence.cron"}
  },
  {
    "id": "TV-020",
    "title": "Encoded PowerShell command",
    "type": "match",
    "severity": "high",
    "tactic": "Execution",
    "technique": "T1059.001",
    "technique_name": "Command and Scripting Interpreter: PowerShell",
    "description": "PowerShell launched with a Base64-encoded command, often used to hide payloads.",
    "match": {"kind": "process.create", "where": {"command_line": "powershell.*\\s-(e|en|enc|encodedcommand)\\s"}}
  },
  {
    "id": "TV-021",
    "title": "LSASS memory dump (credential theft)",
    "type": "match",
    "severity": "critical",
    "tactic": "Credential Access",
    "technique": "T1003.001",
    "technique_name": "OS Credential Dumping: LSASS Memory",
    "description": "A known tool or technique was used to dump LSASS process memory.",
    "match": {"kind": "process.create", "where": {"command_line": "mimikatz|sekurlsa|procdump.*lsass|comsvcs.*minidump|lsass\\.dmp"}}
  },
  {
    "id": "TV-022",
    "title": "New service installed",
    "type": "match",
    "severity": "medium",
    "tactic": "Persistence",
    "technique": "T1543.003",
    "technique_name": "Create or Modify System Process: Windows Service",
    "description": "A Windows service was installed; review the binary path for legitimacy.",
    "match": {"kind": "service.install"}
  },
  {
    "id": "TV-023",
    "title": "Account added to privileged group",
    "type": "match",
    "severity": "high",
    "tactic": "Privilege Escalation",
    "technique": "T1098",
    "technique_name": "Account Manipulation",
    "description": "A principal was added to a local or domain admin group.",
    "match": {"kind": "group.add", "where": {"group": "admin|domain admins|enterprise admins|backup operators"}}
  },
  {
    "id": "TV-024",
    "title": "Security event log cleared",
    "type": "match",
    "severity": "critical",
    "tactic": "Defense Evasion",
    "technique": "T1070.001",
    "technique_name": "Indicator Removal: Clear Windows Event Logs",
    "description": "The Security log was wiped - strong indicator of anti-forensics.",
    "match": {"kind": "log.cleared"}
  },
  {
    "id": "TV-025",
    "title": "Scheduled task created",
    "type": "match",
    "severity": "medium",
    "tactic": "Persistence",
    "technique": "T1053.005",
    "technique_name": "Scheduled Task/Job: Scheduled Task",
    "description": "A scheduled task was registered.",
    "match": {"kind": "task.create"}
  },
  {
    "id": "TV-100",
    "title": "Password brute force",
    "type": "threshold",
    "severity": "medium",
    "tactic": "Credential Access",
    "technique": "T1110",
    "technique_name": "Brute Force",
    "description": "Five or more failed logins from one source with no more than 5 minutes between attempts.",
    "match": {"kind": "auth.failure"},
    "group_by": "src_ip",
    "count": 5,
    "window": 300
  },
  {
    "id": "TV-101",
    "title": "Brute force followed by successful login",
    "type": "followed_by",
    "severity": "critical",
    "tactic": "Initial Access",
    "technique": "T1078",
    "technique_name": "Valid Accounts",
    "description": "A source that just brute-forced credentials logged in successfully within 15 minutes.",
    "internal_tactic": "Lateral Movement",
    "group_by": "src_ip",
    "window": 900,
    "first": {"match": {"kind": "auth.failure"}, "min_count": 5},
    "then": {"match": {"kind": "auth.success"}}
  },
  {
    "id": "TV-102",
    "title": "Password spraying",
    "type": "threshold",
    "severity": "high",
    "tactic": "Credential Access",
    "technique": "T1110.003",
    "technique_name": "Brute Force: Password Spraying",
    "description": "One source failed logins against five or more different accounts in a short burst.",
    "match": {"kind": "auth.failure"},
    "group_by": "src_ip",
    "distinct": "user",
    "count": 5,
    "window": 600
  },
  {
    "id": "TV-200",
    "title": "AWS console login without MFA",
    "type": "match",
    "severity": "medium",
    "tactic": "Initial Access",
    "technique": "T1078.004",
    "technique_name": "Valid Accounts: Cloud Accounts",
    "description": "A successful AWS Management Console sign-in that did not use multi-factor authentication.",
    "match": {"kind": "auth.success", "where": {"event_name": "^ConsoleLogin$", "mfa_used": "^No$"}}
  },
  {
    "id": "TV-201",
    "title": "AWS root account used",
    "type": "match",
    "severity": "high",
    "tactic": "Privilege Escalation",
    "technique": "T1078.004",
    "technique_name": "Valid Accounts: Cloud Accounts",
    "description": "The AWS root user should almost never be used; any activity needs an owner and a reason.",
    "match": {"kind": ["auth.success", "cloud.api", "cloud.denied"], "where": {"user_type": "^Root$"}}
  },
  {
    "id": "TV-202",
    "title": "Cloud audit logging or monitoring disabled",
    "type": "match",
    "severity": "critical",
    "tactic": "Defense Evasion",
    "technique": "T1562.008",
    "technique_name": "Impair Defenses: Disable or Modify Cloud Logs",
    "description": "CloudTrail, VPC flow logs, GuardDuty or Security Hub was stopped, deleted or reconfigured.",
    "match": {"kind": "cloud.api", "where": {"event_name": "^(StopLogging|DeleteTrail|UpdateTrail|PutEventSelectors|DeleteFlowLogs|DeleteDetector|DisableSecurityHub)$"}}
  },
  {
    "id": "TV-203",
    "title": "Administrator policy granted to IAM identity",
    "type": "match",
    "severity": "high",
    "tactic": "Privilege Escalation",
    "technique": "T1098.003",
    "technique_name": "Account Manipulation: Additional Cloud Roles",
    "description": "An admin-level or wildcard policy was attached to a user, role or group.",
    "match": {"kind": "cloud.api", "where": {"event_name": "^(Attach|Put)(User|Role|Group)Policy$", "request": "AdministratorAccess|IAMFullAccess|Action\\W{1,6}\\*\\W"}}
  },
  {
    "id": "TV-204",
    "title": "IAM user or access key created",
    "type": "match",
    "severity": "medium",
    "tactic": "Persistence",
    "technique": "T1098.001",
    "technique_name": "Account Manipulation: Additional Cloud Credentials",
    "description": "New long-lived AWS credentials were created - a common way to keep access after a password reset.",
    "match": {"kind": "cloud.api", "where": {"event_name": "^(CreateUser|CreateAccessKey|CreateLoginProfile|UpdateLoginProfile)$"}}
  },
  {
    "id": "TV-205",
    "title": "Burst of denied AWS API calls",
    "type": "threshold",
    "severity": "medium",
    "tactic": "Discovery",
    "technique": "T1580",
    "technique_name": "Cloud Infrastructure Discovery",
    "description": "An identity hit five or more access-denied errors in quick succession, typical of probing what stolen credentials can do.",
    "match": {"kind": "cloud.denied"},
    "group_by": "user",
    "count": 5,
    "window": 300
  },
  {
    "id": "TV-206",
    "title": "S3 Block Public Access removed",
    "type": "match",
    "severity": "high",
    "tactic": "Defense Evasion",
    "technique": "T1562",
    "technique_name": "Impair Defenses",
    "description": "The guard rail that prevents S3 data from being made public was removed.",
    "match": {"kind": "cloud.api", "where": {"event_name": "^Delete(Bucket|Account)?PublicAccessBlock$"}}
  },
  {
    "id": "TV-207",
    "title": "Cloud storage opened to the public",
    "type": "match",
    "severity": "critical",
    "tactic": "Collection",
    "technique": "T1530",
    "technique_name": "Data from Cloud Storage",
    "description": "A bucket policy or ACL now grants access to everyone.",
    "match": {"kind": "cloud.api", "where": {"event_name": "^PutBucket(Policy|Acl)$", "request": "AllUsers|Principal\\W{1,6}\\*|Principal\\W{1,12}AWS\\W{1,6}\\*"}}
  },
  {
    "id": "TV-210",
    "title": "Mailbox forwarding rule created",
    "type": "match",
    "severity": "high",
    "tactic": "Collection",
    "technique": "T1114.003",
    "technique_name": "Email Collection: Email Forwarding Rule",
    "description": "An inbox rule or mailbox setting forwards or redirects mail - the classic business-email-compromise move.",
    "match": {"kind": "saas.activity", "where": {"operation": "^(New-InboxRule|Set-InboxRule|UpdateInboxRules|Set-Mailbox)$", "parameters": "ForwardTo|ForwardAsAttachmentTo|RedirectTo|ForwardingSmtpAddress|ForwardingAddress"}}
  },
  {
    "id": "TV-211",
    "title": "OAuth application granted consent",
    "type": "match",
    "severity": "high",
    "tactic": "Credential Access",
    "technique": "T1528",
    "technique_name": "Steal Application Access Token",
    "description": "A user consented to a third-party app, which then gets standing access to their data.",
    "match": {"kind": "saas.activity", "where": {"operation": "^Consent to application"}}
  },
  {
    "id": "TV-212",
    "title": "MFA push bombing",
    "type": "threshold",
    "severity": "high",
    "tactic": "Credential Access",
    "technique": "T1621",
    "technique_name": "Multi-Factor Authentication Request Generation",
    "description": "Five or more MFA pushes or denials for one user in quick succession.",
    "match": {"kind": ["mfa.push", "mfa.deny"]},
    "group_by": "user",
    "count": 5,
    "window": 600
  },
  {
    "id": "TV-213",
    "title": "MFA fatigue followed by successful login",
    "type": "followed_by",
    "severity": "critical",
    "tactic": "Initial Access",
    "technique": "T1621",
    "technique_name": "Multi-Factor Authentication Request Generation",
    "description": "The user denied several MFA prompts and then a login succeeded - they likely gave in to the flood.",
    "group_by": "user",
    "window": 900,
    "first": {"match": {"kind": "mfa.deny"}, "min_count": 3},
    "then": {"match": {"kind": "auth.success"}}
  },
  {
    "id": "TV-214",
    "title": "Logins from two countries in a short time",
    "type": "field_change",
    "severity": "high",
    "tactic": "Initial Access",
    "technique": "T1078.004",
    "technique_name": "Valid Accounts: Cloud Accounts",
    "description": "Successful logins for one account from different countries less than 2 hours apart (impossible travel).",
    "match": {"kind": "auth.success"},
    "group_by": "user",
    "field": "country",
    "window": 7200
  }
]
